{
  "name": "space-mission-design-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A turn-based space mission design wargame built for the NASA Space Apps Challenge 2026.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:data": "esbuild scripts/check-data.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-data.mjs --log-level=warning && node node_modules/.cache/check-data.mjs",
    "audit:options": "esbuild scripts/audit-options.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/audit-options.mjs --log-level=warning && node node_modules/.cache/audit-options.mjs",
    "check:engine": "esbuild scripts/check-engine.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-engine.mjs --log-level=warning && node node_modules/.cache/check-engine.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
